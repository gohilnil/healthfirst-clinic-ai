# ─── HealthFirst Clinic AI — Environment Variables ─────────────────────────────
# Copy this to .env for local dev. On Railway, set these in the Variables tab.
# NEVER commit .env to git.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Railway auto-provides this when you add a PostgreSQL service.
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway

# ─── Groq API ─────────────────────────────────────────────────────────────────
# Free at: https://console.groq.com → API Keys → Create API Key
# Models used:
#   LLM:         llama-3.1-70b-versatile  (fast, free, JSON mode supported)
#   Transcription: whisper-large-v3       (free, accurate)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Twilio ───────────────────────────────────────────────────────────────────
# Found at: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Call Behaviour ───────────────────────────────────────────────────────────
# Maximum conversation turns before forcing callback offer
MAX_CALL_TURNS=15

# Twilio voice (Polly.Joanna = natural US English via AWS Polly)
# Alternatives: alice, Polly.Amy (UK), Polly.Raveena (Indian English)
TWILIO_VOICE=Polly.Joanna

# Max seconds patient can speak per turn
RECORD_MAX_LENGTH=30

# Seconds of silence before Twilio stops recording
RECORD_TIMEOUT=4
